APP_NAME="myOrder"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db                    # 👈 เปลี่ยนจาก 127.0.0.1 เป็น db (service name)
DB_PORT=3306
DB_DATABASE=my_database       # 👈 เปลี่ยนให้ตรงกับ docker-compose
DB_USERNAME=root
DB_PASSWORD=rootpassword      # 👈 ใส่รหัสผ่านให้ตรง

# ── Google OAuth ──────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Storage ───────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Queue ─────────────────────────────────────────────
QUEUE_CONNECTION=sync

# ── Mail ────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@myorder.co.th"
MAIL_FROM_NAME="${APP_NAME}"

# ── Sanctum ───────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:5173
SESSION_DRIVER=database
SESSION_LIFETIME=120