APP_NAME="myOrder"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ossd14
DB_USERNAME=root
DB_PASSWORD=

# ── Google OAuth ──────────────────────────────────────
# สร้างจาก https://console.cloud.google.com/
# ต้องเพิ่ม Authorized redirect URI: http://localhost:5173
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Storage ───────────────────────────────────────────
# local = เก็บใน storage/app
# s3    = เก็บใน AWS S3 (แนะนำสำหรับ production)
FILESYSTEM_DISK=local

# ตั้งค่านี้ถ้าใช้ S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=myorder-attachments
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Queue ─────────────────────────────────────────────
# sync = รัน job ทันที (dev)
# database / redis = async (prod)
QUEUE_CONNECTION=sync

# ── Mail (สำหรับ Notification) ────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@myorder.co.th"
MAIL_FROM_NAME="${APP_NAME}"

# ── Sanctum ───────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000
SESSION_DRIVER=database
SESSION_LIFETIME=120
